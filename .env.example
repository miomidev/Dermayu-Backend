# 1. Database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/dermayu?schema=public"

# 2. Authentication (JWT)
JWT_SECRET="ganti_dengan_random_secret_yang_panjang_dan_aman"
